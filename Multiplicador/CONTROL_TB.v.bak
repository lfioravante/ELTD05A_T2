`timescale 1ns / 1ps

module CONTROL_TB;
    reg clk, k, st, m, rst;
    wire idle, done, load, sh, ad;

    CONTROL dut (
        .Clk(clk),
        .K(k),
        .St(st),
        .M(m),
        .rst(rst),
        .Idle(idle),
        .Done(done),
        .Load(load),
        .Sh(sh),
        .Ad(ad)
    );

    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    initial begin
        k = 1'b0; st = 1'b0; m = 1'b0; rst = 1'b1;
        
        @(negedge clk);
        @(negedge clk);
        rst = 1'b0;

        @(negedge clk);
        st = 1'b1;
        @(negedge clk);
        st = 1'b0;

        @(negedge clk);
        m = 1'b1;
        
        @(negedge clk);
        k = 1'b0;

        @(negedge clk);
        m = 1'b0;
        
        @(negedge clk);
        k = 1'b1;

        @(negedge clk);
        k = 1'b0;
        
        @(negedge clk);
        $finish;
    end

    initial begin
        $monitor("Tempo=%0t | rst=%b | St=%b | M=%b | K=%b || Idle=%b | Load=%b | Ad=%b | Sh=%b | Done=%b", 
                 $time, rst, st, m, k, idle, load, ad, sh, done);
    end
endmodule