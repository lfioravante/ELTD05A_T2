`timescale 1ns/1ps
module alu_TB;
	reg [31:0] data_in_1;    
	reg [31:0] data_in_2;
	reg [1:0] bits_sel;
	wire [31:0] data_out; 
	wire zero;
	
	
	alu #(.WIDTH(32)) DUT ( .data_in_1(data_in_1), .data_in_2(data_in_2), .data_out(data_out), .zero(zero) );

	initial clk = 0;
	always #10 clk = ~clk;
	initial begin
		bits_sel = 2'b00;
		data_in_1 = 32'h5;
		data_in_2 = 32'h3;
		
		#10
		if(data_out === 32'h8)
			$display("OK 1: out=%h e zero=%h", data_out, zero);
		else
			$display("ERRO 1: out=%h", data_out);
			
		data_in_1 = 32'hFFFFFFFF;
		data_in_2 = 32'h1;
		#20
		if(data_out === 32'h0)
			$display("OK 1: out=%h", data_out);
		else
			$display("ERRO 1: out=%h", data_out);
			
		bits_sel = 2'b01;
		data_in_1 = 32'h5;
		data_in_2 = 32'h3;
		#10
		if(data_out === 32'h2)
			$display("OK 1: out=%h", data_out);
		else
			$display("ERRO 1: out=%h", data_out);
		
		data_in_1 = 32'h3;
		data_in_2 = 32'h5;
		
		bits_sel = 2'b10;
		
		
		bits_sel = 2'b11;
		
	end
	
endmodule